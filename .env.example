# Example environment variables for Autobattler Server
# Copy this to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/autobattler
DB_HOST=localhost:5432
DB_NAME=autobattler

# Server Configuration
TEST_MODE=false
PORT=8000

# For Northflank deployment, set these in the Northflank dashboard:
# - DATABASE_URL will be automatically provided by Northflank PostgreSQL addon
# - TEST_MODE should be false for production
# - DB_HOST and DB_NAME are optional (DATABASE_URL takes precedence)
