# Multi-stage build for production deployment on Northflank
# Optimized for layer caching - ordered from least to most frequently changing

# ============================================
# Stage 1: Builder with system dependencies
# ============================================
FROM python:3.13-slim as builder

# Install build dependencies needed for Python packages (rarely changes)
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy only requirements first (changes occasionally)
COPY requirements.txt .

# Install Python dependencies to user directory
RUN pip install --user --no-cache-dir -r requirements.txt

# ============================================
# Stage 2: Production image
# ============================================
FROM python:3.13-slim

# Layer 1: Runtime system dependencies (rarely changes)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Layer 2: Create user (rarely changes)
RUN useradd -m -u 1000 appuser

# Layer 3: Set up directory structure (rarely changes)
WORKDIR /app

# Layer 4: Copy Python packages (changes when requirements change)
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Layer 5: Copy application code (changes most frequently)
COPY --chown=appuser:appuser . .

# Switch to non-root user
USER appuser

# Add local bin to PATH
ENV PATH=/home/appuser/.local/bin:$PATH

# Expose port
EXPOSE 8000

# Health check for Northflank
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

# Run with production settings
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
